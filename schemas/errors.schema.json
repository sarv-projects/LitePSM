{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litespm.dev/schemas/v1/errors.schema.json",
  "title": "LiteSPMError",
  "type": "object",
  "required": ["code", "message", "category", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^LPSM-[A-Z]+-[A-Z0-9_-]+$"
    },
    "message": { "type": "string" },
    "category": { "type": "string" },
    "retryable": { "type": "boolean" },
    "correlationId": { "type": "string" },
    "causeCode": { "type": "string" },
    "details": { "type": "object" }
  },
  "additionalProperties": false
}
