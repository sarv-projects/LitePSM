# Byte-faithful files: their bytes are compared against recorded sha256
# digests or other committed fixtures, so a CRLF checkout on Windows
# (core.autocrlf=true, the Git-for-Windows default) breaks every such
# comparison. These are never text-converted.
**/testdata/** -text
fixtures/** -text
# The published /v1 release tree is digest-chained (pointer -> manifest ->
# files); conversion would invalidate the chain on a Windows checkout.
web/public/v1/** -text
