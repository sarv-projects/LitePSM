    "version": "1.2.0",
    "testedHosts": ["Cline", "Pi Agent", "Grok Build", "Codex", "Claude Code"],
    "readme": "# PostgreSQL MCP Server\n\nA secure Model Context Protocol server providing structured read and schema inspection operations for PostgreSQL databases.\n\n## Capabilities\n- `query`: Execute read-only SQL queries with automatic transaction rollback on failure\n- `list_tables`: List all database tables and column schemas\n- `describe_table`: Detailed table statistics and indexes",
    "schemaFingerprint": "sha256:4a8e3d8f89b1c9e2b02e779a1d528b184ef11739c947514a387799518dcfc88a",
    "tools": [
      {
        "name": "query",
        "description": "Execute SQL queries with safety limits",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sql": { "type": "string" },
            "limit": { "type": "integer", "default": 50 }
          },
          "required": ["sql"]
        }
      },
      {
        "name": "list_tables",
        "description": "List all tables in the current schema",
        "inputSchema": {
          "type": "object",
          "properties": {
            "schema": { "type": "string", "default": "public" }
          }
        }
      }
    ],
    "effects": [
      { "effect": "net:outbound:db", "declaredBy": "publisher_declared" },
      { "effect": "fs:read:config", "declaredBy": "curated" }
    ]
  },
